# Google Maps SDK for Android key. Required for the map picker (react-native-maps)
# on Android builds. iOS uses Apple Maps and does not need this key.
# Enable "Maps SDK for Android" in Google Cloud Console and restrict the key to
# the app package (com.nafe3.mobile) and your signing SHA-1.
#
# Set this in your shell/EAS secret or in a local .env file (not committed).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Dev-only: login with a dummy account when the backend is unreachable
# (network/timeout failure during login signs you in as a mock session).
# Enabled by default in development builds; set to 1 to force it in any build,
# or set to 0 to explicitly disable it in dev.
EXPO_PUBLIC_ALLOW_MOCK_LOGIN=
# EXPO_PUBLIC_DISABLE_MOCK_LOGIN=1
